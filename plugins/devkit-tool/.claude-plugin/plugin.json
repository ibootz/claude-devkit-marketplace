{
  "name": "devkit-tool",
  "version": "6.10.0",
  "description": "工具技能集：代码库分析、依赖排查、CLAUDE.md/.claude rules 初始化、codegraph 建图、插件缓存刷新、嵌套 submodule 提交推送、孤儿进程清理（7 技能）",
  "author": {
    "name": "zhangq"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/codegraph-hint.js"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/codegraph-hint.js"
          }
        ]
      }
    ]
  }
}
