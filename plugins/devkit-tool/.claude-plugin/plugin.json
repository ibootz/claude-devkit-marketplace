{
  "name": "devkit-tool",
  "version": "6.34.0",
  "description": "工具技能集：代码库分析、依赖排查、大头桶核实、ROI 报告、CLAUDE.md 初始化、codegraph 建图、插件缓存刷新、submodule 同步、提交推送、起会话与交接、孤儿进程清理、订阅恢复、话题可视化、技术文档、挖未知（16）",
  "author": {
    "name": "zhangq"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/worktree-cwd-recovery.js",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/codegraph-hint.js"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/codegraph-hint.js"
          }
        ]
      }
    ]
  }
}
