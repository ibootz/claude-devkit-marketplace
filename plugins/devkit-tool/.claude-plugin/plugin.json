{
  "name": "devkit-tool",
  "version": "6.19.0",
  "description": "工具技能集：代码库分析、依赖排查、大头桶定性核实、需求全流程耗时/ROI 报告流水线、CLAUDE.md/.claude rules 初始化、codegraph 建图、插件缓存刷新、submodule 拉取同步与嵌套提交推送、起前后台会话、孤儿进程清理、订阅鉴权恢复（12 技能）",
  "author": {
    "name": "zhangq"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/worktree-cwd-recovery.js",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/codegraph-hint.js"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/codegraph-hint.js"
          }
        ]
      }
    ]
  }
}
