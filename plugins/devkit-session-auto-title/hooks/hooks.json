{
  "description": "UserPromptSubmit：按轮数与 assistant 行数到阈值后台生成会话标题，下一轮回填 sessionTitle。",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
