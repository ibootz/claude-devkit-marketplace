{
  "name": "plain-talk-output-style",
  "version": "1.5.0",
  "description": "说人话输出风格 - 一语中的、几句话讲明白、能表格不成段；不专业化不掉书袋不自造词。/plugin 启停即切换风格",
  "author": {
    "name": "zhangq"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
