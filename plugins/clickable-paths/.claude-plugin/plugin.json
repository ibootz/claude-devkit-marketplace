{
  "name": "clickable-paths",
  "version": "1.6.0",
  "description": "文件路径写成可点击链接 - 注入格式规约：对话正文用 file:（iTerm2 里 cmd+click 跳 VS Code），落盘 md 用 vscode:（预览里可跳）。CLICKABLE_PATHS=off 可关",
  "author": {
    "name": "zhangq"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/clickable-paths.js"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/clickable-paths.js"
          }
        ]
      }
    ]
  }
}
