{
  "name": "discover-unknowns",
  "version": "2.3.0",
  "description": "发现你的未知 - 3 skill（统领 / brainstorm / quiz 默认跳过、按需才出）+ 每轮未知雷达 hook（DISCOVER_UNKNOWNS_RADAR=off 可关）",
  "author": {
    "name": "zhangq"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/unknowns-radar.js"
          }
        ]
      }
    ]
  }
}
