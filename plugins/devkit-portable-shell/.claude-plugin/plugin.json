{
  "name": "devkit-portable-shell",
  "version": "2.0.0",
  "description": "跨平台交付 - SessionStart 注入交付脚本 macOS/Windows 双通规则；Write/Edit 生成 shell 时 lint 不可移植写法（PORTABLE_SHELL_LINT=off 关 lint）",
  "author": {
    "name": "zhangq"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/session-start.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/portable-shell-lint.js"
          }
        ]
      }
    ]
  }
}
